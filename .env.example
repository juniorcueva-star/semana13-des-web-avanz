# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# Google OAuth  -> https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth  -> https://github.com/settings/developers
GITHUB_ID=
GITHUB_SECRET=

# NextAuth  -> secreto: https://generate-secret.vercel.app/32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Upstash Redis (solo necesario en Vercel; en local se usa memoria)
# Vercel > Storage > Upstash for Redis las crea automáticamente.
KV_REST_API_URL=
KV_REST_API_TOKEN=
